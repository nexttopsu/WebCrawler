{
  "name": "@webcrawler/database",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "WebCrawler 数据库层（ORMlet + SQLite）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@webcrawler/shared": "workspace:*",
    "ormlet": "^2.1.2"
  }
}
