{
  "name": "webcrawler",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "WebCrawler - 插件化网页采集平台（pnpm workspace：apps/server + apps/web）",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm --filter @webcrawler/server dev\" \"pnpm --filter @webcrawler/web dev\"",
    "build": "pnpm --filter @webcrawler/server build && pnpm --filter @webcrawler/web build",
    "start": "pnpm --filter @webcrawler/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @webcrawler/server test:watch",
    "db:init": "pnpm --filter @webcrawler/server db:init",
    "fixture": "pnpm --filter @webcrawler/server fixture",
    "demo:crawl": "pnpm --filter @webcrawler/server demo:crawl",
    "seed": "pnpm --filter @webcrawler/server seed",
    "smoke": "pnpm --filter @webcrawler/server smoke",
    "smoke:ui": "pnpm --filter @webcrawler/server smoke:ui"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "md5": "^2.3.0"
  }
}
